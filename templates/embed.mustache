{{!
    @template filter_powerbi/embed

    A Power BI report placed in content.

    Context variables required for this template:
    * title - Report title, for screen readers and the fallback link.
    * height - Height in pixels.
    * href - Address of the report in Power BI.
    * src - Secure embed address (secure mode).
    * embedded - Shown with an embed token (embedded mode).
    * contextid, reference - Signed reference to ask for the token (embedded mode).
    * error - Why the report cannot be shown.

    Example context (json):
    {
        "title": "Course completion",
        "height": 600,
        "href": "https://app.powerbi.com/groups/me/reports/00000000-0000-0000-0000-000000000000",
        "src": "https://app.powerbi.com/reportEmbed?reportId=00000000-0000-0000-0000-000000000000&autoAuth=true"
    }
}}
<figure class="filter-powerbi" data-region="filter-powerbi">
    {{#error}}
    <div class="alert alert-warning mb-0">{{error}}</div>
    {{/error}}
    {{^error}}
    <div class="filter-powerbi-frame" style="--filter-powerbi-height: {{height}}px;"
        {{#embedded}}data-embed="1" data-contextid="{{contextid}}" data-reference="{{reference}}"{{/embedded}}>
        {{#src}}
        <iframe title="{{title}}" src="{{src}}" loading="lazy" allowfullscreen="true"></iframe>
        {{/src}}
        {{#embedded}}
        <div class="filter-powerbi-status" data-region="status" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            {{#str}}loading, filter_powerbi{{/str}}
        </div>
        {{/embedded}}
    </div>
    {{/error}}
    <figcaption class="filter-powerbi-caption small">
        <a href="{{href}}" target="_blank" rel="noopener">{{title}}</a>
        {{^error}}
        <button type="button" class="btn btn-link btn-sm p-0 ms-2 ml-2" data-action="filter-powerbi-fullscreen">
            <i class="fa fa-expand" aria-hidden="true"></i> {{#str}}fullscreen, filter_powerbi{{/str}}
        </button>
        {{/error}}
    </figcaption>
</figure>
